@model List<Pokemon>
@{
    ViewData["Title"] = "Pokemons";
    var page = ViewBag.Page as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 10;
}

<div class="container text-center mt-4">
    <h1 class="mb-4">Lista de Pokémons</h1>

    <form class="row g-2 justify-content-center mb-3" method="get">
        <div class="col-auto">
            <label class="form-label">Por página</label>
            <input type="number" name="pageSize" min="1" max="50" value="@pageSize" class="form-control" />
        </div>
        <div class="col-auto align-self-end">
            <input type="hidden" name="page" value="1" />
            <button type="submit" class="btn btn-primary">Actualizar</button>
        </div>
    </form>

    <div class="d-flex flex-wrap justify-content-center gap-4">
        @foreach (var pokemon in Model)
        {
            <div class="card" style="width: 18rem;">
                @if (pokemon.Images != null && pokemon.Images.Count > 1)
                {
                    var carouselId = "carousel-" + pokemon.Id;
                    <div id="@carouselId" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < pokemon.Images.Count; i++)
                            {
                                var img = pokemon.Images[i];
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="@img" class="d-block w-100" alt="@pokemon.Name" style="height:200px; object-fit:contain;" />
                                </div>
                            }
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Siguiente</span>
                        </button>
                    </div>
                }
                else
                {
                    var imgSrc = pokemon.Images != null && pokemon.Images.Count == 1 ? pokemon.Images[0] : pokemon.Sprites?.Front_Default ?? "/favicon.ico";
                    <img src="@imgSrc" class="card-img-top img-fluid p-3" alt="@pokemon.Name" style="height: 200px; width: fit-content; margin: auto; object-fit: contain;" />
                }

                <div class="card-body d-flex flex-column justify-content-between">
                    <h5 class="card-title text-capitalize">@pokemon.Name</h5>
                    <a class="btn btn-primary mt-2" asp-controller="Pokemon" asp-action="Details" asp-route-id="@pokemon.Id">Ver Detalles</a>
                </div>
            </div>
        }
    </div>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" href="?page=@(page-1)&pageSize=@pageSize">Anterior</a>
            </li>
            <li class="page-item">
                <span class="page-link">Página @(page)</span>
            </li>
            <li class="page-item">
                <a class="page-link" href="?page=@(page+1)&pageSize=@pageSize">Siguiente</a>
            </li>
        </ul>
    </nav>
</div>

