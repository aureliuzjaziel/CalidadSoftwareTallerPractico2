@model Pokemon
@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid text-center">
    <h1>@Model.Name</h1>
    <div class="row justify-content-evenly">
        <div class="col-4">
            <img src="@Model.Sprites.Front_Default" alt="@Model.Name" class="img-fluid" />
            <img src="@Model.Sprites.Back_Default" alt="@Model.Name" class="img-fluid" />
            <img src="@Model.Sprites.Front_Shiny" alt="@Model.Name" class="img-fluid" />
            <img src="@Model.Sprites.Back_Shiny" alt="@Model.Name" class="img-fluid" />

        </div>
        <div class="col-4">
            <h3>Altura: @Model.Height</h3>
            <h3>Peso: @Model.Weight</h3>
            <a class="btn btn-primary" asp-controller="Pokemon" asp-action="Index" role="button">Volver a la Lista</a>
        </div>
    </div>
</div>