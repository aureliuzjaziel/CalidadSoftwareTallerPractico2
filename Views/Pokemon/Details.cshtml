@model Pokemon
@{
    ViewData["Title"] = Model.Name;
}

<div class="container text-center mt-4">
    <h1 class="text-capitalize mb-4" style="color: #ffdd00; text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">@Model.Name</h1>

    <div class="row justify-content-center mt-4">
        <div class="col-md-5">
            @if (Model.Images != null && Model.Images.Count > 0)
            {
                <div id="details-carousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images[i];
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img" class="d-block mx-auto" alt="@Model.Name" style="max-height:300px; object-fit:contain;" />
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#details-carousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#details-carousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>
            }
            else
            {
                <img src="@Model.Sprites?.Front_Default" alt="@Model.Name" class="img-fluid" />
            }

            <div class="pokemon-details-sprites mt-3">
                @if (Model.Sprites != null)
                {
                    <img src="@Model.Sprites.Front_Default" alt="front" />
                    <img src="@Model.Sprites.Back_Default" alt="back" />
                    <img src="@Model.Sprites.Front_Shiny" alt="shiny" />
                }
            </div>
        </div>

        <div class="col-md-5 text-start">
            <div style="background: rgba(0,0,0,0.2); padding: 1.5rem; border-radius: 12px; border: 2px solid rgba(255,221,0,0.3);">
                <h4 style="color: #ffdd00;">📊 Detalles</h4>

                <div class="mt-3">
                    <p><strong>Altura:</strong> @Model.Height</p>
                    <p><strong>Peso:</strong> @Model.Weight</p>
                    <p><strong>Orden (Pokédex):</strong> <span style="color: #ffdd00;">#@Model.Order</span></p>
                </div>

                @if (Model.TypeNames != null && Model.TypeNames.Count > 0)
                {
                    <div class="mt-3">
                        <h5 style="color: #ffdd00;">🎯 Tipos</h5>
                        <div class="pokemon-badges justify-content-start mt-2">
                            @foreach (var typeName in Model.TypeNames)
                            {
                                <span class="pokemon-badge type-@typeName.ToLower()">@typeName</span>
                            }
                        </div>
                    </div>
                }

                @if (Model.AbilityNames != null && Model.AbilityNames.Count > 0)
                {
                    <div class="mt-3">
                        <h5 style="color: #ffdd00;">⚡ Habilidades</h5>
                        <div class="pokemon-badges justify-content-start mt-2">
                            @foreach (var abilityName in Model.AbilityNames)
                            {
                                <span class="pokemon-badge">@abilityName</span>
                            }
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <a class="btn btn-primary" asp-controller="Pokemon" asp-action="Index" role="button">Volver a la Lista</a>
                </div>
            </div>
        </div>
    </div>
</div>
